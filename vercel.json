    {
      "src": "/about/?$",
      "dest": "/about.html"
    },
    {
      "src": "/blog/?$",
      "dest": "/blog/index.html"
    },
    {
      "src": "/blog/([^/]+)/?$",
      "dest": "/blog/$1.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
